# ==========================================
# TH-Pack Dashboard Environment Configuration
# ==========================================

# Database Credentials (MySQL)
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=thpack_dashboard
MYSQL_USER=thpack_user
MYSQL_PASSWORD=thpack_pass123

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
ADMINER_PORT=8081
INFLUXDB_PORT=8087
GRAFANA_PORT=3002
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Siemens S7 PLC Gateway Settings
PLC_IP_ADDRESS=192.168.0.101
PLC_RACK=0
PLC_SLOT=1

# InfluxDB Configuration (TIG Stack)
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=adminpassword123
INFLUXDB_ORG=thpack
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=thpack-telemetry-token-123

# Grafana Configuration (TIG Stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=adminpassword123

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=adminpassword123

# Frontend API Endpoint
VITE_API_URL=http://localhost:8000/api
